###> general ###
APP_NAME=koken
TZ=Europe/Berlin
###< general ###

###> web server (PHP 8.5 + Apache) ###
# Port on the host: the site is available at http://localhost:${APACHE_PORT}/
APACHE_PORT=8080
APACHE_HTDOCS=src/htdocs
# Install ffmpeg for video support (true/false); rebuild after changing
INSTALL_FFMPEG=false
###< web server ###

###> database (MariaDB) ###
MARIADB_VERSION=11.8
MARIADB_LOCAL_DIR=./mariadb/data
MARIADB_DATA_DIR=/lib
MYSQL_DATABASE=koken
MYSQL_USER=koken
# setup.sh generates random passwords when they are empty
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
KOKEN_DB_PREFIX=koken_
###< database ###

###> installer ###
# Required to open the web installer (setup.sh generates it and prints the link)
KOKEN_INSTALL_TOKEN=
###< installer ###

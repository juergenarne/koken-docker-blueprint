###> general ###
APP_NAME=koken
TZ=Europe/Berlin
###< general ###

###> web server (PHP 8.5 + Apache) ###
# Port on the host: the site is available at http://localhost:${APACHE_PORT}/
APACHE_PORT=8080
# Interface for that port: 127.0.0.1 behind a reverse proxy (nginx) or for local use,
# 0.0.0.0 to reach the container directly from other machines
APACHE_BIND=127.0.0.1
# Koken's web root (checkout of KOKEN_REPO), mounted into the container:
#   locally  ./src/htdocs (a relative path needs the leading ./)
#   server   /var/www/htdocs/<domain> – belongs to www-data, outside this directory (INSTALL.md)
APACHE_HTDOCS=./src/htdocs
# Install ffmpeg for video support (true/false); rebuild after changing
INSTALL_FFMPEG=false
###< web server ###

###> koken (code repository, cloned into ${APACHE_HTDOCS} by setup.sh) ###
# private repository: needs SSH access (on servers: deploy key of www-data, see INSTALL.md)
KOKEN_REPO=git@github.com:juergenarne/koken2026-installer.git
KOKEN_BRANCH=master
###< koken ###

###> database (MariaDB) ###
MARIADB_VERSION=11.8
MARIADB_LOCAL_DIR=./mariadb/data
MARIADB_DATA_DIR=/lib
# Port on 127.0.0.1 of the host for GUI tools / mysqldump (via SSH tunnel on a server).
# Unique per instance; setup.sh picks a free one (from 3307 on) when it is empty
MYSQL_PORT=
MYSQL_DATABASE=koken
MYSQL_USER=koken
# setup.sh generates random passwords when they are empty
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
KOKEN_DB_PREFIX=koken_
###< database ###

###> mail (SMTP, for "Forgot password?" on the sign-in page) ###
# Empty SMTP_HOST = no mail. Port 587 (STARTTLS) or 465 (TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address, must be allowed for SMTP_USER (default: SMTP_USER)
SMTP_FROM=
# off only for local test servers without encryption (e.g. Mailpit)
SMTP_TLS=
###< mail ###

###> installer ###
# Required to open the web installer (setup.sh generates it and prints the link)
KOKEN_INSTALL_TOKEN=
###< installer ###
